__pycache__/
*.pyc
# the recheck lockfile and run logs. The lock exists because three copies of
# recheck.py once ran at once against one evidence store and one log, turning
# 10 drifted artifacts into 74 without the world changing at all.
.recheck.lock
*.log

# A --quick run measures ONE module and writes its own record so it cannot overwrite the tree's.
# That partial measurement is a smoke test's byproduct, not a deposited artifact: committing it
# would put a 45-site record beside the 316-site one under a name that reads just as official.
CONTROL-AUDIT-quick.json
